# VigilNode Environment Configuration (Placeholders Only — Never Commit Real Secrets)
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Security & Authentication
JWT_SECRET="replace-with-strong-64-char-random-secret"
JWT_EXPIRES_IN="12h"

# Database (SQLite file path; set to :memory: in automated tests)
DB_PATH="./data/vigilnode.db"

# Monitoring Engine
DISABLE_SCHEDULER="false"
ALLOW_PRIVATE_TARGETS="false"
PROBE_CONCURRENCY_LIMIT=10

# Optional Initial Notification Channel Defaults (can also be configured in Admin UI)
GMAIL_SMTP_HOST="smtp.gmail.com"
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
DISCORD_WEBHOOK_URL=""
SLACK_WEBHOOK_URL=""

# Optional Gemini API Key (unused unless AI features enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
